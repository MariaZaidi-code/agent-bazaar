ab:Tool_arxiv-search a ab:Service ;
    rdfs:label "arXiv Research Search" ;
    ab:capability ab:Capability_SearchResearchPapers ;
    ab:hasInput ab:Concept_ResearchTopic ;
    ab:hasOutput ab:Concept_ResearchPaper ;
    ab:makesClaim "Returns titles, summaries and links.",
        "Searches arXiv metadata without an API key." ;
    ab:provider ab:Provider_arxiv .

ab:Tool_arxiv-search-backup a ab:Service ;
    rdfs:label "arXiv Research Search (Backup Mirror)" ;
    ab:capability ab:Capability_SearchResearchPapers ;
    ab:hasInput ab:Concept_ResearchTopic ;
    ab:hasOutput ab:Concept_ResearchPaper ;
    ab:makesClaim "Returns titles, summaries and links.",
        "Searches arXiv metadata without an API key." ;
    ab:provider ab:Provider_arxiv-backup .

ab:Tool_coingecko-price a ab:Service ;
    rdfs:label "CoinGecko Crypto Price" ;
    ab:capability ab:Capability_GetCryptoPrice ;
    ab:hasInput ab:Concept_CryptoAsset,
        ab:Concept_CurrencyCode ;
    ab:hasOutput ab:Concept_CryptoPrice ;
    ab:makesClaim "Returns crypto prices without an API key.",
        "Supports fiat quote currencies such as USD and EUR." ;
    ab:provider ab:Provider_coingecko .

ab:Tool_document-qa a ab:Service ;
    rdfs:label "Uploaded Document Question Answering" ;
    ab:capability ab:Capability_AnswerFromDocument ;
    ab:hasInput ab:Concept_DocumentQuestion,
        ab:Concept_DocumentReference ;
    ab:hasOutput ab:Concept_AnswerFromDocument ;
    ab:makesClaim "Answers from the uploaded document with citations.",
        "Does not send document text to a paid service." ;
    ab:provider ab:Provider_document-service .

ab:Tool_espn-scores a ab:Service ;
    rdfs:label "ESPN Scoreboard" ;
    ab:capability ab:Capability_GetSportsScores ;
    ab:hasInput ab:Concept_SportsLeague ;
    ab:hasOutput ab:Concept_SportsScore ;
    ab:makesClaim "Reports home and away teams with game status.",
        "Returns sports scores without an API key." ;
    ab:provider ab:Provider_espn .

ab:Tool_frankfurter-currency a ab:Service ;
    rdfs:label "Frankfurter Currency Converter" ;
    ab:capability ab:Capability_ConvertCurrency ;
    ab:hasInput ab:Concept_CurrencyCode,
        ab:Concept_MoneyAmount ;
    ab:hasOutput ab:Concept_Money ;
    ab:makesClaim "Converts an amount between supported currencies without an API key.",
        "The output states the effective rate and date." ;
    ab:provider ab:Provider_frankfurter .

ab:Tool_frankfurter-currency-backup a ab:Service ;
    rdfs:label "Frankfurter Currency Converter (Backup Mirror)" ;
    ab:capability ab:Capability_ConvertCurrency ;
    ab:hasInput ab:Concept_CurrencyCode,
        ab:Concept_MoneyAmount ;
    ab:hasOutput ab:Concept_Money ;
    ab:makesClaim "Converts an amount between supported currencies without an API key.",
        "The output states the effective rate and date." ;
    ab:provider ab:Provider_frankfurter-backup .

ab:Tool_google-books-search a ab:Service ;
    rdfs:label "Google Books Search" ;
    ab:capability ab:Capability_SearchBooks ;
    ab:hasInput ab:Concept_BookQuery ;
    ab:hasOutput ab:Concept_Book ;
    ab:makesClaim "Returns titles, authors and publication dates.",
        "Searches Google Books without a user-supplied API key." ;
    ab:provider ab:Provider_google-books .

ab:Tool_hackernews-search a ab:Service ;
    rdfs:label "Hacker News Story Search" ;
    ab:capability ab:Capability_SearchNews ;
    ab:hasInput ab:Concept_NewsTopic ;
    ab:hasOutput ab:Concept_NewsArticle ;
    ab:makesClaim "Returns story titles, links and publication timestamps.",
        "Searches Hacker News stories without an API key." ;
    ab:provider ab:Provider_hackernews .

ab:Tool_mock-weather-fahrenheit a ab:Service ;
    rdfs:label "Mock Weather Adversary" ;
    ab:capability ab:Capability_GetWeatherForecast ;
    ab:hasInput ab:Concept_Coordinates,
        ab:Concept_DateTimeISO ;
    ab:hasOutput ab:Concept_Temperature ;
    ab:makesClaim "No API key is required.",
        "Returns temperature in Celsius." ;
    ab:provider ab:Provider_mock-weather-fahrenheit .

ab:Tool_mymemory-translate a ab:Service ;
    rdfs:label "MyMemory Translation" ;
    ab:capability ab:Capability_TranslateText ;
    ab:hasInput ab:Concept_LanguageCode,
        ab:Concept_Text ;
    ab:hasOutput ab:Concept_Translation ;
    ab:makesClaim "Returns the detected language pair and match score.",
        "Translates short text without an API key." ;
    ab:provider ab:Provider_mymemory .

ab:Tool_nager-holidays a ab:Service ;
    rdfs:label "Nager.Date Public Holidays" ;
    ab:capability ab:Capability_GetPublicHolidays ;
    ab:hasInput ab:Concept_CountryCode,
        ab:Concept_Number ;
    ab:hasOutput ab:Concept_Holiday ;
    ab:makesClaim "No API key is required.",
        "Returns public holidays by country and year." ;
    ab:provider ab:Provider_nager-date .

ab:Tool_nager-holidays-backup a ab:Service ;
    rdfs:label "Nager.Date Public Holidays (Backup Mirror)" ;
    ab:capability ab:Capability_GetPublicHolidays ;
    ab:hasInput ab:Concept_CountryCode,
        ab:Concept_Number ;
    ab:hasOutput ab:Concept_Holiday ;
    ab:makesClaim "No API key is required.",
        "Returns public holidays by country and year." ;
    ab:provider ab:Provider_nager-date-backup .

ab:Tool_nominatim-geocode a ab:Service ;
    rdfs:label "OpenStreetMap Nominatim Geocoder" ;
    ab:capability ab:Capability_GeocodeLocation ;
    ab:hasInput ab:Concept_LocationName ;
    ab:hasOutput ab:Concept_Coordinates ;
    ab:makesClaim "Resolves place names without an API key.",
        "Returns coordinates in WGS84 degrees." ;
    ab:provider ab:Provider_nominatim .

ab:Tool_nominatim-geocode-backup a ab:Service ;
    rdfs:label "OpenStreetMap Nominatim Geocoder (Backup Mirror)" ;
    ab:capability ab:Capability_GeocodeLocation ;
    ab:hasInput ab:Concept_LocationName ;
    ab:hasOutput ab:Concept_Coordinates ;
    ab:makesClaim "Resolves place names without an API key.",
        "Returns coordinates in WGS84 degrees." ;
    ab:provider ab:Provider_nominatim-backup .

ab:Tool_open-library-search a ab:Service ;
    rdfs:label "Open Library Book Search" ;
    ab:capability ab:Capability_SearchBooks ;
    ab:hasInput ab:Concept_BookQuery ;
    ab:hasOutput ab:Concept_Book ;
    ab:makesClaim "Returns titles, authors and first publication years.",
        "Searches Open Library without an API key." ;
    ab:provider ab:Provider_open-library .

ab:Tool_open-meteo-forecast a ab:Service ;
    rdfs:label "Open-Meteo Weather Forecast" ;
    ab:capability ab:Capability_GetWeatherForecast ;
    ab:hasInput ab:Concept_Coordinates,
        ab:Concept_DateTimeISO ;
    ab:hasOutput ab:Concept_Temperature ;
    ab:makesClaim "No API key is required.",
        "Provides a daily forecast for the requested location.",
        "Returns temperatures in Celsius." ;
    ab:provider ab:Provider_open-meteo .

ab:Tool_open-meteo-forecast-backup a ab:Service ;
    rdfs:label "Open-Meteo Weather Forecast (Backup Mirror)" ;
    ab:capability ab:Capability_GetWeatherForecast ;
    ab:hasInput ab:Concept_Coordinates,
        ab:Concept_DateTimeISO ;
    ab:hasOutput ab:Concept_Temperature ;
    ab:makesClaim "No API key is required.",
        "Provides a daily forecast for the requested location.",
        "Returns temperatures in Celsius." ;
    ab:provider ab:Provider_open-meteo-backup .

ab:Tool_restcountries-facts a ab:Service ;
    rdfs:label "REST Countries Fact Service" ;
    ab:capability ab:Capability_GetCountryFacts ;
    ab:hasInput ab:Concept_CountryName ;
    ab:hasOutput ab:Concept_Country ;
    ab:makesClaim "Returns ISO country codes.",
        "Returns population and capital without an API key." ;
    ab:provider ab:Provider_rest-countries .

ab:Tool_restcountries-facts-backup a ab:Service ;
