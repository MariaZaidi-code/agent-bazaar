ab:Tool_university-sql a ab:Service ;
    rdfs:label "University Read-only SQL Provider" ;
    ab:capability ab:Capability_QueryStructuredData ;
    ab:hasInput ab:Concept_NaturalLanguageQuery ;
    ab:hasOutput ab:Concept_TabularAnswer ;
    ab:makesClaim "Rejects writes and non-allow-listed tables.",
        "Uses a read-only connection to the local sample database." ;
    ab:provider ab:Provider_university-db .

ab:Tool_worldtime-current a ab:Service ;
    rdfs:label "WorldTimeAPI Current Time" ;
    ab:capability ab:Capability_GetCurrentTime ;
    ab:hasInput ab:Concept_TimezoneName ;
    ab:hasOutput ab:Concept_CurrentTime ;
    ab:makesClaim "Reports the IANA timezone and UTC offset.",
        "Returns the current time without an API key." ;
    ab:provider ab:Provider_worldtimeapi .

