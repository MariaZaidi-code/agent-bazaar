ab:Tool_tvmaze-search a ab:Service ;
    rdfs:label "TVMaze Show Search" ;
    ab:capability ab:Capability_SearchTVShows ;
    ab:hasInput ab:Concept_ShowQuery ;
    ab:hasOutput ab:Concept_TVShow ;
    ab:makesClaim "Returns genres, premiere dates and ratings.",
