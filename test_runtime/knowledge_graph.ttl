ab:Tool_sunrise-sunset-times a ab:Service ;
    rdfs:label "Sunrise-Sunset Solar Times" ;
    ab:capability ab:Capability_GetSunTimes ;
    ab:hasInput ab:Concept_Coordinates,
        ab:Concept_DateTimeISO ;
    ab:hasOutput ab:Concept_SunTimes ;
    ab:makesClaim "Reports day length in seconds.",
        "Returns solar times without an API key." ;
    ab:provider ab:Provider_sunrise-sunset .

ab:Tool_themealdb-recipes a ab:Service ;
    rdfs:label "TheMealDB Recipe Search" ;
    ab:capability ab:Capability_SearchRecipes ;
    ab:hasInput ab:Concept_RecipeQuery ;
    ab:hasOutput ab:Concept_Recipe ;
    ab:makesClaim "Returns ingredients, instructions and a meal image.",
        "Searches recipes without an API key." ;
