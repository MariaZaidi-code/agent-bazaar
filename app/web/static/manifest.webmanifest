{
  "id": "/dashboard",
  "name": "Agent Bazaar",
  "short_name": "Agent Bazaar",
  "description": "Find trusted tools, run them, and see the evidence.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#101113",
  "theme_color": "#101113",
  "categories": ["productivity", "utilities", "business"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "/static/pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/pwa/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/pwa/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Ask a question",
      "short_name": "Ask",
      "description": "Open the Ask anything landing page.",
      "url": "/dashboard",
      "icons": [{ "src": "/static/pwa/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Find tools",
      "short_name": "Tools",
      "description": "Search the tool marketplace.",
      "url": "/marketplace",
      "icons": [{ "src": "/static/pwa/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "System health",
      "short_name": "Health",
      "description": "Check providers and circuits.",
      "url": "/monitor",
      "icons": [{ "src": "/static/pwa/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Your files",
      "short_name": "Files",
      "description": "Open the documents workspace.",
      "url": "/documents",
      "icons": [{ "src": "/static/pwa/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "screenshots": [
    {
      "src": "/static/pwa/screenshots/wide-dashboard.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Ask anything and see the verified answer"
    },
    {
      "src": "/static/pwa/screenshots/narrow-marketplace.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Find trusted tools"
    }
  ]
}
