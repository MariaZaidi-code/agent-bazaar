# Agent Bazaar configuration. All variables are optional.

# Run without network calls using deterministic cached fixtures.
AB_OFFLINE_MODE=true

# Runtime data (SQLite databases, uploads, caches). Relative paths resolve from the repo root.
AB_RUNTIME_DIR=data/runtime

# Optional free-tier LLM. The app works fully without one.
# Supported providers: none, openrouter, groq, gemini
AB_LLM_PROVIDER=none
AB_LLM_API_KEY=
AB_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
AB_LLM_BASE_URL=https://openrouter.ai/api/v1

# Client and safety settings
AB_BREAKER_FAILURE_THRESHOLD=2
AB_BREAKER_COOLDOWN_SECONDS=30
AB_TRUST_DEMOTION_THRESHOLD=0.4
AB_EXCLUDE_CONTRADICTED=false
AB_RANKING_TOP_K=8

# Ablation switches used by evaluation scripts
AB_USE_ONTOLOGY=true
AB_USE_AUDITOR=true
AB_USE_TRUST=true
AB_USE_FEEDBACK=true
AB_USE_SUBSTITUTION=true
AB_USE_CIRCUIT_BREAKER=true
