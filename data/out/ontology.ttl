@prefix ab: <https://agent-bazaar.local/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://agent-bazaar.local/ontology> a owl:Ontology ;
    rdfs:label "Agent Bazaar upper ontology" ;
    rdfs:comment "Hand-written upper layer, frozen at the end of Week 2 (Proposal v1.3 Section 8.1)." .

ab:Address a owl:Class,
        ab:Concept ;
    rdfs:label "Address" ;
    rdfs:subClassOf ab:Concept ;
    skos:altLabel "formatted_address",
        "street_address" ;
    ab:hasDataType "string" .

ab:AreaSize a owl:Class,
        ab:Concept ;
    rdfs:label "Area" ;
    rdfs:subClassOf ab:Concept ;
    skos:altLabel "area",
        "land_area",
        "surface_area" ;
    ab:defaultUnit <https://agent-bazaar.local/unit#SquareKilometre> ;
    ab:hasDataType "float" ;
    ab:unitBearing true ;
    ab:unitFamily ab:AreaUnit .

ab:BaseCurrency a owl:Class,
        ab:Concept ;
    rdfs:label "Base currency" ;
    rdfs:subClassOf ab:Concept ;
    skos:altLabel "base",
        "from_currency" ;
    ab:hasDataType "string" .

ab:BooleanFlag a owl:Class,
