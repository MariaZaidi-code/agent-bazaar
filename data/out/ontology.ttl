ab:Temperature a owl:Class,
        ab:Concept ;
    rdfs:label "Temperature" ;
    rdfs:subClassOf ab:Concept ;
    skos:altLabel "temp",
        "temp_c",
        "temperature_2m",
        "temperature_c" ;
    ab:defaultUnit <https://agent-bazaar.local/unit#Celsius> ;
    ab:hasDataType "float" ;
    ab:unitBearing true ;
    ab:unitFamily ab:TemperatureUnit .

