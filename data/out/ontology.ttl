    rdfs:label "Capability" .

ab:CountryCode a owl:Class,
        ab:Concept ;
    rdfs:label "Country code" ;
    rdfs:subClassOf ab:Concept ;
    skos:altLabel "alpha2",
        "alpha3",
        "cc",
        "country_code",
        "iso_code" ;
    ab:hasDataType "string" .

ab:Name a owl:Class,
        ab:Concept ;
    rdfs:label "Name" ;
    rdfs:subClassOf ab:Concept ;
    skos:altLabel "display_name_text",
        "label",
        "title" ;
    ab:hasDataType "string" .

