<https://agent-bazaar.local/ontology> a owl:Ontology ;
    rdfs:label "Agent Bazaar upper ontology" ;
    rdfs:comment "Hand-written upper layer, frozen at the end of Week 2 (Proposal v1.3 Section 8.1)." .

ab:CloudCover a owl:Class,
        ab:Concept ;
    rdfs:label "Cloud cover" ;
    rdfs:subClassOf ab:Concept ;
    skos:altLabel "cloud_cover",
        "cloudiness",
        "clouds" ;
    ab:defaultUnit unit:Percent ;
    ab:hasDataType "float" ;
    ab:unitBearing true ;
    ab:unitFamily ab:PercentageUnit .

ab:DewPoint a owl:Class,
        ab:Concept ;
    rdfs:label "Dew point" ;
    rdfs:subClassOf ab:Concept ;
    skos:altLabel "dew_point",
        "dewpoint" ;
    ab:defaultUnit unit:Celsius ;
    ab:hasDataType "float" ;
    ab:unitBearing true ;
    ab:unitFamily ab:TemperatureUnit .

ab:ExchangeRate a owl:Class,
        ab:Concept ;
    rdfs:label "Exchange rate" ;
    rdfs:subClassOf ab:Concept ;
    skos:altLabel "conversion_rate",
        "exchange_rate",
        "fx_rate",
        "rate" ;
    ab:hasDataType "float" .

ab:FeelsLikeTemperature a owl:Class,
        ab:Concept ;
    rdfs:label "Feels-like temperature" ;
    rdfs:subClassOf ab:Temperature ;
    skos:altLabel "apparent_temperature",
        "feels_like",
        "heat_index" ;
    ab:defaultUnit unit:Celsius ;
    ab:hasDataType "float" ;
    ab:unitBearing true ;
    ab:unitFamily ab:TemperatureUnit .

ab:Forecast a owl:Class,
