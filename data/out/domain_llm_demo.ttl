ab:APICreditCount a owl:Class,
        ab:Concept ;
    rdfs:label "API credit count" ;
    rdfs:comment "The total or remaining API credits available for an account." ;
    rdfs:subClassOf ab:Count ;
    skos:altLabel "Credits",
        "api_credits",
        "credits_remaining" ;
    ab:defaultUnit <https://agent-bazaar.local/unit#Count> ;
    ab:hasDataType "integer" ;
    ab:unitBearing true ;
    ab:unitFamily ab:CountUnit .

