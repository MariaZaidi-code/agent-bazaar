      "options": {
        "field_path": "docs"
      },
      "expected_detector": "rule",
      "expected_round": 1,
      "description": "Search results array removed."
    },
    {
      "id": "drift-07",
      "tool_id": "open-meteo",
      "behavior": "remove_field",
      "options": {
        "field_path": "current.wind_speed_10m"
      },
      "expected_detector": "rule",
      "expected_round": 1,
      "description": "Wind speed field removed."
    },
