      "behavior": "unit_change",
      "options": {
        "field_path": "current.temperature_2m",
        "unit_path": "current_units.temperature_2m",
        "from_unit": "celsius",
        "to_unit": "fahrenheit"
      },
      "expected_detector": "rule",
      "expected_round": 1,
      "description": "Temperature silently switches from Celsius to Fahrenheit."
