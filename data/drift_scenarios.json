      "id": "drift-08",
      "tool_id": "arxiv",
      "behavior": "remove_field",
      "options": {
        "field_path": "feed.entry.title"
      },
      "expected_detector": "rule",
      "expected_round": 1,
      "description": "Entry title removed from the Atom response."
    },
    {
      "id": "drift-09",
      "tool_id": "cat-fact",
      "behavior": "type_change",
      "options": {
        "field_path": "length",
        "replacement": "not-a-number"
      },
      "expected_detector": "rule",
      "expected_round": 1,
      "description": "Fact length changes from number to text."
    },
    {
      "id": "drift-10",
      "tool_id": "coingecko",
      "behavior": "type_change",
