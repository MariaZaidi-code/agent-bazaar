{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Auditor: Install dev dependencies",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "pip",
        "install",
        "-e",
        ".[dev]"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Auditor: Run tests",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "pytest",
        "-q"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Auditor: Lint",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "ruff",
        "check",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Auditor: Demo",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "agent_bazaar_auditor",
        "demo"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Auditor: Evaluate",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "agent_bazaar_auditor",
        "evaluate"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Auditor: Serve mock API",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "agent_bazaar_auditor",
        "serve",
        "--mock"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
