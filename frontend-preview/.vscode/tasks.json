{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start frontend preview",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "http.server",
        "5510",
        "--bind",
        "127.0.0.1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
